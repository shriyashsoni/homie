# ─────────────────────────────────────────────────────────────
# Find My Homie — frontend environment variables
# Copy these into Vercel → Project → Settings → Environment Variables.
# All VITE_* vars are inlined at BUILD time (they are PUBLIC, not secrets).
# ─────────────────────────────────────────────────────────────

# Convex backend URL (required)
VITE_CONVEX_URL=https://chatty-flamingo-542.convex.cloud

# Firebase (Google sign-in). Public config — safe to expose.
VITE_FIREBASE_API_KEY=AIzaSyD0xwoK_oDJm1QmJG61TuAnuWpG6SzCBsk
VITE_FIREBASE_AUTH_DOMAIN=homie-7ac90.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=homie-7ac90
VITE_FIREBASE_STORAGE_BUCKET=homie-7ac90.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=486106210033
VITE_FIREBASE_APP_ID=1:486106210033:web:ea2eb0601eca522481d350
VITE_FIREBASE_MEASUREMENT_ID=G-GXXPRYQXPT

# Google OAuth Web client ID (public — safe). Not required for the Firebase
# popup flow; kept here for reference / future Google One-Tap use.
VITE_GOOGLE_CLIENT_ID=486106210033-tj6tdcm26tj2uaer8u5mclrh8ji3gkrr.apps.googleusercontent.com

# NOTE: the Google Web client SECRET is intentionally NOT here.
# It must never be a VITE_ var (those are bundled into the browser).
# The app does not use it — Firebase handles the OAuth exchange.

# ─────────────────────────────────────────────────────────────
# SECRET — only needed if you let Vercel deploy Convex during build.
# Do NOT prefix with VITE_ (must never reach the browser).
# Set this ONLY in the Vercel dashboard, never commit it.
# CONVEX_DEPLOY_KEY=prod:chatty-flamingo-542|xxxxxxxxxxxxxxxx
# ─────────────────────────────────────────────────────────────
